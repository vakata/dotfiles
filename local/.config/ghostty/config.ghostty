term = xterm-256color
font-family = "MonoLisaCode"
font-family = "Symbols Nerd Font Mono"
font-size = 15
adjust-cell-height = 50%
window-padding-x = 10
window-padding-y = 10,50
theme = "Catppuccin Macchiato"
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor
keybind = performable:cmd+c=copy_to_clipboard:plain
keybind = ctrl+insert=text:\x1b[99;9u
keybind = performable:ctrl+insert=copy_to_clipboard:plain
keybind = cmd+v=paste_from_clipboard
keybind = shift+insert=paste_from_clipboard

