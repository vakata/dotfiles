{
    "position": "top",
    "height": 40,
    "exclusive": true,
    "spacing": 2,
    "margin-top": 5,
    "margin-left": 5,
    "margin-right": 5,

    "modules-left": [
        "hyprland/workspaces"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "hyprland/language",
        "custom/vpn",
        "custom/tablet",
        "network",
        "bluetooth",
        "pulseaudio",
        "custom/processes",
        "battery"
    ],

    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "{:%A, %d %B %Y}"
    },

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "tooltip": false,
        "persistent-workspaces": {
            "*": 5
        }
    },
    "hyprland/language": {
        "format": "{}",
        "format-en": "EN",
        "format-bg": "БГ",
        "on-click": "hyprctl switchxkblayout current next",
        "tooltip": true,
        "tooltip-format": "Keyboard layout: {}"
    },

    "network": {
        "format-wifi": "󰤨",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤭",
        "tooltip-format-wifi": "{essid}\nSignal: {signalStrength}%\nIP: {ipaddr}",
        "tooltip-format-ethernet": "{ifname}\nIP: {ipaddr}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "ghostty --title=control-network -e impala"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-connected": "󰂱",
        "tooltip-format": "Bluetooth",
        "tooltip-format-connected": "{device_alias}",
        "on-click": "ghostty --title=control-bluetooth -e bluetui"
    },

    "pulseaudio": {
        "format": "󰕾",
        "format-muted": "󰝟",
        "tooltip-format": "Volume: {volume}%\n{desc}",
        "on-click": "ghostty --title=control-audio -e pulsemixer"
    },

    "custom/tablet": {
        "format": "󰦪",
        "tooltip": true,
        "tooltip-format": "Toggle tablet orientation",
        "on-click": "/home/vakata/.local/bin/tablet-toggle"
    },

    "custom/processes": {
        "format": "󰍛",
        "tooltip": true,
        "justify": "center",
        "align": 0.5,
        "tooltip-format": "Processes",
        "on-click": "ghostty --title=control-processes -e htop"
    },

    "custom/vpn": {
        "exec": "~/.local/bin/waybar-vpn",
        "return-type": "json",
        "interval": 10,
        "signal": 8,
        "justify": "center",
        "align": 0.5,
        "on-click": "~/.local/bin/toggle-vpn"
    },

    "custom/disks": {
        "format": "󰋊",
        "tooltip": true,
        "tooltip-format": "Disk usage",
        "on-click": "ghostty --title=control-disks -e ncdu"
    },

    "battery": {
        "interval": 60,
        "format": "{icon}",
        "states": {
            "warning": 30,
            "critical": 15
        },
        "events": {
            "on-discharging-warning": "notify-send -u normal 'Low Battery'",
            "on-discharging-critical": "notify-send -u critical 'Very Low Battery'",
            "on-charging-100": "notify-send -u normal 'Battery Full!'",
            "on-discharging": "notify-send -u normal 'Power Switch' Discharging",
            "on-charging": "notify-send -u normal 'Power Switch' Charging'"
        },
        "tooltip-format": "{capacity}%\n{timeTo}\n{power} W",
        "format-icons": {
            "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
            "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"]
        },
        "on-click": "ghostty --title=control-power -e power-ui"
    }
}
