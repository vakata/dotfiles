[general]
status_path = "~/.local/share/vdirsyncer/status/"

[pair icloud_calendar]
a = "icloud_local"
b = "icloud_remote"
collections = ["from b"]
metadata = ["displayname", "color"]

[storage icloud_local]
type = "filesystem"
path = "~/.local/share/calendars/icloud/"
fileext = ".ics"

[storage icloud_remote]
type = "caldav"
url = "https://caldav.icloud.com/"
username.fetch = ["command", "bw", "get", "username", "iCloud Calendar"]
password.fetch = ["command", "bw", "get", "password", "iCloud Calendar"]
